@inherits LayoutComponentBase

<header class="app-header">
    <h1>Blazor Dual Listbox</h1>
    <p>A generic, accessible dual-listbox component for Blazor — move items between two lists
        via buttons, double-click, or the keyboard. Render-mode agnostic, no CSS framework required.</p>
    <div class="links">
        <a href="https://github.com/olufemioyedepo/blazor-dual-listbox" target="_blank" rel="noopener">GitHub</a>
        <a href="https://www.nuget.org/packages/BlazorDualListbox" target="_blank" rel="noopener">NuGet</a>
    </div>
</header>

<main>
    @Body
</main>

<footer class="app-footer">
    Built with Blazor WebAssembly ·
    <a href="https://github.com/olufemioyedepo/blazor-dual-listbox" target="_blank" rel="noopener">olufemioyedepo/blazor-dual-listbox</a>
    · MIT License
</footer>
